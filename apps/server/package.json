{
  "name": "@portfolio/server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "docker exec -i portfolio-postgres psql -U postgres -d portfolio -f - < migrations/001_create_users.sql"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@portfolio/api": "workspace:*",
    "@trpc/server": "catalog:",
    "hono": "^4.7.11"
  },
  "devDependencies": {
    "@types/node": "^25",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3"
  }
}
